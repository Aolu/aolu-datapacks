function on_load minecraft:load {
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy
    tellraw @a [{"color":"#e3bf47","text":"["},{"color":"white","text":"Gold Tier"},{"color":"#e3bf47","text":"]"},{"color":"white","text":": "},{"color":"white","text":"Loaded!"}]
    function aolu_gold_tier:gold_check
    
}   



function tick minecraft:tick {
    execute as @a run function aolu_gold_tier:player
}

clock gold_check 1s {
    execute as @e[type=!player] run function aolu_gold_tier:player
}

function player {
    tag @s remove holding_gold_tool

    attribute @s minecraft:attack_damage modifier remove gt:atk

    execute if predicate aolu_gold_tier:holding_golden_sword run { 
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2.5 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }
    execute if predicate aolu_gold_tier:holding_golden_axe run {
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }
    execute if predicate aolu_gold_tier:holding_golden_pickaxe run {
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2.5 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }
    execute if predicate aolu_gold_tier:holding_golden_hoe run {
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2.5 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }
    execute if predicate aolu_gold_tier:holding_golden_shovel run {
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2.5 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }
    execute if predicate aolu_gold_tier:holding_golden_spear run {
        tag @s add holding_gold_tool
        attribute @s minecraft:attack_damage modifier add gt:atk 2.5 add_value
        item modify entity @s weapon.mainhand aolu_gold_tier:gold_durability
    }

    execute if predicate aolu_gold_tier:wearing_gold_helmet run {
        item modify entity @s armor.head aolu_gold_tier:gold_helmet
    }
    execute if predicate aolu_gold_tier:wearing_gold_chestplate run {
        item modify entity @s armor.chest aolu_gold_tier:gold_chestplate
    }
    execute if predicate aolu_gold_tier:wearing_gold_leggings run {
        item modify entity @s armor.legs aolu_gold_tier:gold_leggings
    }
    execute if predicate aolu_gold_tier:wearing_gold_boots run {
        item modify entity @s armor.feet aolu_gold_tier:gold_boots
    }
}

item_modifier gold_durability {
    "function": "minecraft:set_components",
    "components": {
        "minecraft:max_damage": 750
    }
}


item_modifier gold_helmet {
    "function": "minecraft:set_components",
    "components": {
        "minecraft:attribute_modifiers": [
            {
                "type": "minecraft:armor",
                "id": "gt:harm",
                "amount": 2.5,
                "operation": "add_value",
                "slot": "head"
            },
            {
                "type": "minecraft:armor_toughness",
                "id": "gt:hart",
                "amount": 1,
                "operation": "add_value",
                "slot": "head"
            }
        ],
        "minecraft:max_damage": 264
    }
}


