predicate holding_golden_sword {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "type": "minecraft:player",
        "equipment": {
            "mainhand": {
                "items": "minecraft:golden_sword"
            }
        }
    }
}
