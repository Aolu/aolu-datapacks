function on_load minecraft:load{
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy
    scoreboard objectives add amv_chance dummy
    scoreboard objectives add amv_hurt_time dummy
    scoreboard objectives add amv_ability_cooldown dummy
    scoreboard objectives add amv_elite_ability_cooldown dummy
    scoreboard objectives add amv_summon_cooldown dummy
    scoreboard objectives add amv_elite_type dummy

    
    scoreboard objectives add amv_elite_hp_b dummy
    scoreboard objectives add amv_elite_hp_a dummy
    scoreboard objectives add amv_elite_hp_d dummy

    team add amv_elite_protector
    team modify amv_elite_protector color gold

    team add amv_elite_cloaker
    team modify amv_elite_cloaker color dark_aqua

    team add amv_elite_mist
    team modify amv_elite_mist color gray

    team add amv_elite_bulwark
    team modify amv_elite_bulwark color dark_green

    team add amv_elite_mender
    team modify amv_elite_mender color yellow

    team add amv_elite_warper
    team modify amv_elite_warper color dark_purple

    team add amv_elite_dampener
    team modify amv_elite_dampener color dark_blue

	tellraw @a [{"color":"#ff1515","text":"["},{"color":"white","text":"Monster Variants"},{"color":"#ff1515","text":"]"},{"color":"white","text":": "},{"color":"white","text":"Loaded!"}]
}

function on_tick minecraft:tick{

    # entity tick
    execute as @e[type=fireball] at @s on origin if entity @s[tag=amv_ghasp] as @n[type=fireball] run{
        execute summon small_fireball run {
            data modify entity @s Motion set from entity @n[type=fireball] Motion
        }
        kill @s
    }
    execute as @e[type=!#aolu_common_resources:ignore] at @s run {
        execute if entity @s[tag=amv_dampen] run function aolu_monster_variants:remove_dampen
        execute as @s[tag=amv_elite] run function aolu_monster_variants:elite_tick
        execute on target if score @s[tag=amv_elite] amv_elite_type matches 7 as @n run function aolu_monster_variants:dampen

        execute as @s[type=!player] run {
            execute if entity @n[distance=0.1..25]
            execute if entity @s[tag=amv_elite] if entity @p[distance=..25] run effect give @s glowing 1
            execute store result score @s amv_hurt_time run data get entity @s HurtTime
            execute if score @s amv_hurt_time matches 10 on attacker as @n[type=!player] run function aolu_monster_variants:entity_took_damage
            execute as @s[tag=!amv_check] run function aolu_monster_variants:entity_check
            execute if score @s amv_ability_cooldown matches 1.. run {
                scoreboard players remove @s amv_ability_cooldown 1
            }
            execute if score @s amv_summon_cooldown matches 1.. run {
                scoreboard players remove @s amv_summon_cooldown 1
            }
            execute if entity @s[type=!player] run function aolu_monster_variants:entity_tick
        }
    }
    
}

function entity_check {
    tag @s add amv_check
    scoreboard players add @s amv_ability_cooldown 0
    execute store result score @s amv_chance run random value 0..100
    execute if score @s[tag=!amv_elite,tag=!amv_not_elite] amv_chance matches ..3 run {
        function aolu_monster_variants:make_elite
    } else run {
        tag @s add amv_not_elite
    }
    execute store result score @s amv_chance run random value 0..100
    
    # undead check
    execute if entity @s[type=#minecraft:undead] run {
        execute if score @s amv_chance matches ..5 run effect give @s minecraft:infested infinite
    }

    execute store result score @s amv_chance run random value 0..100

    # skeleton check
    execute if entity @s[type=#minecraft:skeletons] run {
        

        # 1
        execute if score @s amv_chance matches ..5 run {
            item replace entity @s weapon.mainhand with minecraft:iron_axe
            attribute @s minecraft:max_health modifier add amv_stats 1.5 add_multiplied_total
            attribute @s minecraft:scale modifier add amv_stats 0.25 add_multiplied_total
            attribute @s minecraft:knockback_resistance modifier add amv_stats 1 add_value
            attribute @s minecraft:movement_speed modifier add amv_stats -0.15 add_multiplied_total
            tag @s add amv_skeleton_brute
        }

        # 2
        execute if score @s amv_chance matches 6..40 run {
            item replace entity @s weapon.mainhand with minecraft:iron_sword
            tag @s add amv_skeleton_scout
        }

        execute if score @s[type=wither_skeleton] amv_chance matches 80..100 run {
            item replace entity @s weapon.mainhand with minecraft:bow
            tag @s add amv_wither_skeleton_archer
        }
        function aolu_monster_variants:heal
    }

    # arthropod check
    execute if entity @s[type=#minecraft:arthropod] run {
        execute store result score @s amv_chance run random value 0..100
        execute if score @s amv_chance matches ..5 run effect give @s minecraft:infested infinite
        execute store result score @s amv_chance run random value 0..100

        # 1
        execute if score @s amv_chance matches ..4 run {
            scoreboard players add @s amv_summon_cooldown 0
            data merge entity @s {CustomName:{"bold":false,"color":"white","text":"Brood Mother"}}
            attribute @s minecraft:max_health modifier add amv_stats 2.5 add_multiplied_total      
            attribute @s minecraft:scale modifier add amv_stats 0.65 add_multiplied_total
            attribute @s minecraft:attack_damage modifier add amv_stats 0.8 add_multiplied_total
            attribute @s minecraft:knockback_resistance modifier add amv_stats 0.9 add_value
            tag @s add amv_brood_mother
        }
        
        function aolu_monster_variants:heal
    }

    # ghast check
    execute if entity @s[type=ghast] run {
        execute if score @s amv_chance matches ..10 run {
            execute summon ghast run function aolu_monster_variants:add_summon
            execute summon ghast run function aolu_monster_variants:add_summon
            execute summon ghast run function aolu_monster_variants:add_summon
            execute summon ghast run function aolu_monster_variants:add_summon
            tp @s ~ -1000 ~
        }
    }

    # elite check
    execute if entity @s[tag=amv_elite] run {
        execute store result score @s amv_elite_hp_b run data get entity @s Health
    }
}

function entity_tick {

    # arthropod
    execute if entity @s[type=#minecraft:arthropod] run {
        execute if score @s[tag=amv_brood_mother] amv_summon_cooldown matches 0 on target as @n[tag=amv_brood_mother] run {
            scoreboard players set @s amv_summon_cooldown 50
            execute if entity @s[type=spider] summon minecraft:spider run function aolu_monster_variants:add_summon
            execute if entity @s[type=cave_spider] summon minecraft:cave_spider run function aolu_monster_variants:add_summon
            execute if entity @s[type=silverfish] summon minecraft:silverfish run function aolu_monster_variants:add_summon
            execute if entity @s[type=endermite] summon minecraft:endermite run function aolu_monster_variants:add_summon
        }
    }

}

function entity_took_damage {
    execute store result score @s amv_chance run random value 0..100
    scoreboard players add @s amv_summon_cooldown 0
    execute if entity @s[tag=amv_elite,type=#aolu_monster_variants:hostile] run {
        execute store result score @s amv_elite_hp_a run data get entity @s Health
        scoreboard players operation @s amv_elite_hp_b -= @s amv_elite_hp_a
        scoreboard players operation @s amv_elite_hp_d += @s amv_elite_hp_b
        execute store result score @s amv_elite_hp_b run data get entity @s Health
        function aolu_monster_variants:spawn_xp
    }
}

function spawn_xp {
    
    execute if score @s amv_elite_hp_d matches 2.. run {
        scoreboard players remove @s amv_elite_hp_d 2
        summon minecraft:experience_orb ~ ~ ~ {Value:5}
    }
    execute if score @s amv_elite_hp_d matches ..-1 run scoreboard players set @s amv_elite_hp_d 0
    execute if score @s amv_elite_hp_d matches 2.. run function aolu_monster_variants:spawn_xp
}

function add_summon {
    tag @s add amv_check
    effect give @s resistance 1 4 true
    
    # hatchling
    execute if entity @s[type=#minecraft:arthropod] run {
        data merge entity @s {CustomName:{"bold":false,"color":"white","text":"Hatchling"}}
        playsound minecraft:entity.turtle.egg_break master @a ~ ~ ~ 1 1.3
        attribute @s minecraft:max_health modifier add amv_stats -0.95 add_multiplied_total
        attribute @s minecraft:scale modifier add amv_stats -0.4 add_multiplied_total
        attribute @s minecraft:attack_damage modifier add amv_stats -0.5 add_multiplied_total
        attribute @s minecraft:movement_speed modifier add amv_stats 0.25 add_multiplied_total
        execute on passengers run tp @s ~ -1000 ~
    }

    execute if entity @s[type=ghast] run {
        data merge entity @s {CustomName:{"bold":false,"color":"white","text":"Ghasp"}}
        attribute @s minecraft:max_health modifier add amv_stats -0.5 add_multiplied_total
        attribute @s minecraft:scale modifier add amv_stats -0.7 add_multiplied_total
        tag @s add amv_ghasp
    }
}

function heal {
    execute if entity @s[type=#minecraft:undead] run {
        effect give @s minecraft:instant_damage 10 100
    } else run {
        effect give @s minecraft:instant_health 10 100
    }
}

function small_heal {
    particle minecraft:happy_villager ~ ~ ~ 0.5 0.5 0.5 0 10 force
    execute if entity @s[type=#minecraft:undead] run {
        effect give @s minecraft:instant_damage 1 0
    } else run {
        effect give @s minecraft:instant_health 1 0
    }
}

function make_elite {
    tag @s add amv_elite
    attribute @s minecraft:max_health modifier add amv_elite 2 add_multiplied_total
    attribute @s minecraft:attack_damage modifier add amv_elite 0.5 add_multiplied_total
    attribute @s minecraft:armor modifier add amv_elite 15 add_value
    function aolu_monster_variants:heal
    execute store result score @s amv_elite_type run random value 1..7
    scoreboard players set @s amv_elite_ability_cooldown 200
    
    attribute @s minecraft:armor modifier remove amv_elite_bulwark
    attribute @s minecraft:armor_toughness modifier remove amv_elite_bulwark
    attribute @s minecraft:knockback_resistance modifier remove amv_elite_bulwark
    attribute @s minecraft:movement_speed modifier remove amv_elite_bulwark
    attribute @s minecraft:scale modifier remove amv_elite_bulwark

    # elite types
    # 1 - Protector. Grants resistance 4 to nearby mobs
    # 2 - Cloaker. Grants invisibility to nearby mobs
    # 3 - Mist. Blinds nearby players and produces a large cloud of smoke
    # 4 - Bulwark. Has Immense Defenses, Immune to knockback, is Slow
    # 5 - Mender. Periodically Heals nearby mobs
    # 6 - Warper. Periodically teleports its target to itself
    # 7 - Dampener. Lowers stats of those that attack it and on its target

    execute if score @s amv_elite_type matches 1 run {
        team join amv_elite_protector @s
        data merge entity @s {CustomName:{"bold":true,"color":"gold","text":"Protector Elite"}}
    }
    execute if score @s amv_elite_type matches 2 run {
        team join amv_elite_cloaker @s
        data merge entity @s {CustomName:{"bold":true,"color":"dark_aqua","text":"Cloaker Elite"}}
    }
    execute if score @s amv_elite_type matches 3 run{
        team join amv_elite_mist @s
        data merge entity @s {CustomName:{"bold":true,"color":"gray","text":"Mist Elite"}}
    }
    execute if score @s amv_elite_type matches 4 run {
        team join amv_elite_bulwark @s
        attribute @s minecraft:armor modifier add amv_elite_bulwark 15 add_value
        attribute @s minecraft:armor_toughness modifier add amv_elite_bulwark 10 add_value
        attribute @s minecraft:knockback_resistance modifier add amv_elite_bulwark 1 add_value
        attribute @s minecraft:movement_speed modifier add amv_elite_bulwark -0.25 add_multiplied_total
        attribute @s minecraft:scale modifier add amv_elite_bulwark 0.5 add_multiplied_total
        data merge entity @s {CustomName:{"bold":true,"color":"dark_green","text":"Bulwark Elite"}}
    }
    execute if score @s amv_elite_type matches 5 run {
        team join amv_elite_mender @s
        data merge entity @s {CustomName:{"bold":true,"color":"yellow","text":"Mender Elite"}}
    }
    execute if score @s amv_elite_type matches 6 run {
        team join amv_elite_warper @s
        data merge entity @s {CustomName:{"bold":true,"color":"dark_purple","text":"Warper Elite"}}
    }
    execute if score @s amv_elite_type matches 7 run {
        team join amv_elite_dampener @s
        data merge entity @s {CustomName:{"bold":true,"color":"dark_blue","text":"Dampener Elite"}}
    }
}

function elite_tick {

    execute if score @s amv_elite_ability_cooldown matches 1.. run {
        scoreboard players remove @s amv_elite_ability_cooldown 1
    }

    execute on target as @n[tag=amv_elite] run effect give @s glowing 1

    # protector
    execute if score @s amv_elite_type matches 1 run {
        execute if entity @s[type=#aolu_monster_variants:hostile] as @e[type=#aolu_monster_variants:hostile,distance=0.1..10] run {
            effect give @s resistance 1 3
        }
        execute if entity @s[type=!#aolu_monster_variants:hostile] as @e[type=!#aolu_monster_variants:hostile,distance=0.1..10] run {
            effect give @s resistance 1 3
        }
    }

    # cloaker
    execute if score @s amv_elite_type matches 2 run {
        
        execute store result score @s amv_chance run random value 0..40
        execute if score @s amv_chance matches 0 run playsound minecraft:block.bell.resonate master @a ~ ~ ~ 1 1.5

        execute if entity @s[type=#aolu_monster_variants:hostile] as @e[type=#aolu_monster_variants:hostile,distance=0.1..10,tag=!amv_elite] run {
            effect give @s invisibility 1 0
        }
        execute if entity @s[type=!#aolu_monster_variants:hostile] as @e[type=!#aolu_monster_variants:hostile,distance=0.1..10,tag=!amv_elite] run {
            effect give @s invisibility 1 0
        }
    }
    
    # mist
    execute if score @s amv_elite_type matches 3 run {
        execute on target run effect give @s blindness 2 0
        execute if entity @s[type=#aolu_monster_variants:hostile] run particle minecraft:large_smoke ~ ~ ~ 2 1 2 0 5 force
        execute if entity @s[type=#aolu_monster_variants:hostile] as @e[type=!#aolu_monster_variants:hostile,distance=0.1..3,tag=!amv_elite] run {
            effect give @s blindness 2 0
        }
        execute if entity @s[type=!#aolu_monster_variants:hostile] as @e[type=#aolu_monster_variants:hostile,distance=0.1..3,tag=!amv_elite] run {
            effect give @s blindness 2 0
        }
    }

    # mender
    execute if score @s amv_elite_type matches 5 if score @s amv_elite_ability_cooldown matches 0 run {
        playsound minecraft:block.bubble_column.upwards_inside master @a ~ ~ ~ 1 2
        particle minecraft:totem_of_undying ~ ~ ~ 0 0 0 1 50
        scoreboard players set @s amv_elite_ability_cooldown 50
        execute if entity @s[type=#aolu_monster_variants:hostile] as @e[type=#aolu_monster_variants:hostile,distance=0.1..10,tag=!amv_elite] run {
            function aolu_monster_variants:small_heal
        }
        execute if entity @s[type=!#aolu_monster_variants:hostile] as @e[type=!#aolu_monster_variants:hostile,distance=0.1..10,tag=!amv_elite] run {
            function aolu_monster_variants:small_heal
        }
        
    }

    # warper
    execute if score @s amv_elite_type matches 6 run {
        scoreboard players add @s amv_elite_ability_cooldown 1
        execute if score @s amv_elite_ability_cooldown matches 1.. on target as @n[tag=amv_elite] run {
            scoreboard players remove @s amv_elite_ability_cooldown 1
        }
        execute if score @s amv_elite_ability_cooldown matches 80 on target at @s run {
            playsound minecraft:block.portal.ambient master @a ~ ~ ~ 1 2
            
        }
        execute if score @s amv_elite_ability_cooldown matches ..100 on target at @s run {
            particle minecraft:portal ~ ~.5 ~ 0 0 0 1 15 force
        }

        execute if score @s amv_elite_ability_cooldown matches 40 on target at @s run {
            playsound minecraft:block.portal.trigger master @s ~ ~ ~ 1 2
            effect give @s minecraft:nausea 5
        }

        execute if score @s amv_elite_ability_cooldown matches 0 on target run {
            execute if predicate aolu_common_resources:pressing_crouch run {
                execute at @s run playsound minecraft:block.respawn_anchor.deplete master @a ~ ~ ~ 1 2
                execute at @s run playsound minecraft:block.respawn_anchor.deplete master @a ~ ~ ~ 1 2
            } else run {
                tp @s @n
                playsound minecraft:entity.player.teleport master @a ~ ~ ~ 2 0.5
            }
            scoreboard players set @n[tag=amv_elite] amv_elite_ability_cooldown 160
        }
    }

    # dampener
    execute if score @s amv_elite_type matches 7 run {
        function aolu_monster_variants:dampen
        execute on target run function aolu_monster_variants:dampen
        execute on attacker run function aolu_monster_variants:dampen
    }
}

function dampen {
    tag @s add amv_dampen
    attribute @s minecraft:armor modifier add amv_elite_dampen -0.5 add_multiplied_total
    attribute @s minecraft:armor_toughness modifier add amv_elite_dampen -0.5 add_multiplied_total
    attribute @s minecraft:attack_damage modifier add amv_elite_dampen -0.5 add_multiplied_total
    attribute @s minecraft:movement_speed modifier add amv_elite_dampen -0.4 add_multiplied_total
    execute at @s run {
        execute store result score sound.chance amv_chance run random value 0..20
        execute if score sound.chance amv_chance matches 0 run {
            playsound minecraft:block.conduit.attack.target master @s ~ ~ ~ 1 0.6
            playsound minecraft:block.conduit.attack.target master @s ~ ~ ~ 1 1.4
        }
    }
}

function remove_dampen {
    tag @s remove amv_dampen
    attribute @s minecraft:armor modifier remove amv_elite_dampen
    attribute @s minecraft:armor_toughness modifier remove amv_elite_dampen
    attribute @s minecraft:attack_damage modifier remove amv_elite_dampen
    attribute @s minecraft:movement_speed modifier remove amv_elite_dampen
}

