advancement dealt_damage_with_rapier {
  "criteria": {
    "hit": {
      "trigger": "minecraft:player_hurt_entity",
      "conditions": {
        "player": {
          "equipment": {
            "mainhand": {
              "items": "#minecraft:swords",
              "components": {
                "minecraft:custom_data": {
                  "rapier": true
                }
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "aolu_rapiers:add_charges"
  }
}

