function on_load minecraft:load{
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy
    scoreboard objectives add at.xp dummy
    scoreboard objectives add at.time dummy
    function aolu_tweaks:second

   	tellraw @a [{"color":"#ffae00","text":"["},{"color":"white","text":"Tweaks"},{"color":"#ffae00","text":"]"},{"color":"white","text":": "},{"color":"white","text":"Loaded!"}]
   	tellraw @a [{"color":"#ffae00","text":"-="},{"color":"yellow","text":"Features"},{"color":"#ffae00","text":"=-"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Holding a Shield grants +4 Armor"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Removed Block Delay on Shields"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Difficulty changes based on time of day"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Experience orbs have a chance to double in value based on the difficulty"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Experience orbs track to the nearest Player"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Copper Golems are 50% faster"}]
   	tellraw @a [{"color":"#ffae00","text":"- "},{"color":"white","text":"Enchanted Books can now Stack"}]

}

function tick minecraft:tick {
    execute as @e at @s run function aolu_tweaks:entity_tick
    execute store result score difficulty at.xp run difficulty
    scoreboard players operation difficulty at.xp *= difficulty at.xp
    
   
}

function entity_tick {
    execute if entity @s[type=experience_orb] run function aolu_tweaks:exp_orb_tick
}

function entity_second {
    execute unless predicate aolu_tweaks:offhand_shield run {
         attribute @s minecraft:armor modifier remove at:armor
    }
    execute if predicate aolu_tweaks:offhand_shield run {
        attribute @s minecraft:armor modifier add at:armor 4 add_value
        item modify entity @s weapon.offhand aolu_tweaks:instant_block
    }
    execute if predicate aolu_tweaks:mainhand_shield run {
        attribute @s minecraft:armor modifier add at:armor 4 add_value
        item modify entity @s weapon.mainhand aolu_tweaks:instant_block
    }

    execute if entity @s[type=copper_golem] run {
        attribute @s minecraft:movement_speed modifier add a_tw .5 add_multiplied_total 
    }
}

clock second 1s {
    execute as @e at @s run function aolu_tweaks:entity_second

    
    execute store result score time at.time run time query daytime

    execute if score time at.time matches 1.. run difficulty easy
    execute if score time at.time matches 12000.. run difficulty normal
    execute if score time at.time matches 15000.. run difficulty hard
    execute if score time at.time matches 21000.. run difficulty normal
    
    advancement revoke @a only aolu_tweaks:picked_up_enchanted_book
}

function pickup_book {
    scoreboard players set #counter mcb.internal 0
    execute store result storage aolu:tw count int 1 run scoreboard players get #counter mcb.internal
    function aolu_tweaks:inventory_loop
    advancement revoke @s only aolu_tweaks:picked_up_enchanted_book
}

function inventory_loop {

    execute as @a run {
        function aolu_tweaks:inventory_check with storage aolu:tw
    }
    
    scoreboard players add #counter mcb.internal 1
    execute store result storage aolu:tw count int 1 run scoreboard players get #counter mcb.internal
    execute if score #counter mcb.internal matches ..27 run function aolu_tweaks:inventory_loop
}

function inventory_check {
    $execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"inventory.$(count)":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s inventory.$(count) {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}

    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.0":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.0 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.1":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.1 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.2":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.2 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.3":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.3 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.4":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.4 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.5":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.5 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.6":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.6 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.7":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.7 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"hotbar.8":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s hotbar.8 {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}


    execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"slots":{"weapon.offhand":{"items":"minecraft:enchanted_book"}}}} run item modify entity @s weapon.offhand {"function": "minecraft:set_components","components": {"minecraft:max_stack_size": 64}}
    
}

function exp_orb_tick {
    execute facing entity @p feet run tp @s ^ ^ ^.5
    particle minecraft:enchanted_hit
    
    execute if entity @s[tag=!at_exp_buff] run {
        tag @s add at_exp_buff
        execute store result score @s at.xp run random value 0..9
        execute if score @s at.xp <= difficulty at.xp run {
            execute store result entity @s Value double 1 run data get entity @s Value 2
            particle minecraft:enchanted_hit ~ ~ ~ 0 0 0 1 10
            particle minecraft:totem_of_undying ~ ~ ~ 0 0 0 .1 10
            playsound minecraft:entity.player.levelup master @a ~ ~ ~ 0.05 2
            tag @s add at_exp_double
        }  
    }
}

predicate offhand_shield {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "type": "minecraft:player",
        "equipment": {
            "offhand": {
                "items": "minecraft:shield"
            }
        }
    }
}

predicate mainhand_shield {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "type": "minecraft:player",
        "equipment": {
            "mainhand": {
                "items": "minecraft:shield"
            }
        }
    }
}

item_modifier instant_block {
	"function": "minecraft:set_components",
	"components": {
		"minecraft:blocks_attacks": {
			"block_delay_seconds": 0,
			"block_sound": "minecraft:item.shield.block",
			"bypassed_by": "#minecraft:bypasses_shield",
			"disabled_sound": "minecraft:item.shield.break",
			"item_damage": {
				"base": 1,
				"factor": 1,
				"threshold": 3
			}
		}
	}
}

item_modifier stackable_enchanted_book {
	"function": "minecraft:set_components",
	"components": {
		"minecraft:max_stack_size": 64
	}
}

advancement picked_up_enchanted_book {
    "criteria": {
        "pickup": {
            "trigger": "minecraft:inventory_changed",
            "conditions": {
                "items": [
                    {
                        "items": "minecraft:enchanted_book"
                    }
                ]
            }
        }
    },
    "rewards": {
        "function": "aolu_tweaks:pickup_book"
    }
}